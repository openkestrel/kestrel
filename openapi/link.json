{
  "openapi": "3.1.0",
  "info": {
    "title": "kestrel link",
    "version": "0.1.0",
    "summary": "The connection between an Instance and the control plane.",
    "description": "The supervisor inside an Instance opens this connection outward: server-sent events down, POST up, plain HTTP with no protocol upgrade. A supervisor lives with its Instance, not its Session: it authenticates as the Instance, and every Session on the Instance is begun, prompted and stopped over the one link.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "{link}",
      "variables": {
        "link": {
          "default": "http://127.0.0.1:7717"
        }
      }
    }
  ],
  "security": [
    {
      "instanceCredential": []
    }
  ],
  "paths": {
    "/link/instances/{instance}/answers/{request}": {
      "post": {
        "operationId": "answer",
        "summary": "Answer a read the stream asked of this Instance.",
        "description": "The body is streamed and piped to the operator who asked. A read nobody has begun answering 10 s after it was sent is given up on, and its answer is then refused. A JSON answer is one `Answer`; bytes are a file's contents as they are.",
        "parameters": [
          { "$ref": "#/components/parameters/instance" },
          {
            "name": "request",
            "in": "path",
            "required": true,
            "description": "The `request` the read carried.",
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Answer" } },
            "application/octet-stream": { "schema": { "type": "string", "contentMediaType": "application/octet-stream" } }
          }
        },
        "responses": {
          "204": { "description": "The answer was taken, or the operator stopped reading it." },
          "400": { "$ref": "#/components/responses/Refused" },
          "401": { "$ref": "#/components/responses/Refused" },
          "403": { "$ref": "#/components/responses/Refused" },
          "410": { "$ref": "#/components/responses/Refused" },
          "503": { "$ref": "#/components/responses/Refused" }
        }
      }
    },
    "/link/instances/{instance}/credentials": {
      "get": {
        "operationId": "credentials",
        "summary": "Take what a Session's Harness is spawned with.",
        "description": "Answered as the supervisor spawns a Session's Harness, and asked at no other moment: the control plane decrypts them here. Every Provider Credential the Session's Organization holds, and the variables and files of the Subscription Profile its Workspace names, which no other Workspace's Session is handed. Variables reach that process's environment and nothing else; files are written beneath the agent's home for the length of the Session. Only a Session the Instance is carrying is answered for, so an Instance between Sessions is handed nothing.",
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/session"
          }
        ],
        "responses": {
          "200": {
            "description": "The variables and files the Harness is spawned with.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credentials"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "410": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      },
      "patch": {
        "operationId": "refreshCredentials",
        "summary": "Hand back the files the Harness rewrote.",
        "description": "A harness refreshes its login where it keeps it, and a refresh may revoke the login it replaced, so the supervisor hands back every file it was given that changed before it reports the Session's turn over. Only files the Workspace's Subscription Profile already holds are taken; any other path is ignored.",
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "$ref": "#/components/parameters/session"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Refreshed"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "What the profile holds is what was handed back."
          },
          "400": {
            "$ref": "#/components/responses/Refused"
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "410": {
            "$ref": "#/components/responses/Refused"
          },
          "422": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/link/instances/{instance}/entries": {
      "get": {
        "operationId": "entries",
        "summary": "Read one window of the Transcript of the Workspace holding this Instance.",
        "description": "At most one window of entries, in order, and the cursor the next read resumes from. A cursor names a position rather than a read held open, so it still walks after the control plane restarts; one that names no position in this Transcript is refused rather than silently restarting the walk.",
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The cursor a previous read ended with. Absent means from the beginning.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "How many entries to return at most.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One window of the Transcript, and the cursor the next read resumes from.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Refused"
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/link/instances/{instance}/instructions": {
      "get": {
        "operationId": "instructions",
        "summary": "Hold open the stream of instructions for an Instance.",
        "description": "One stream per Instance, carrying every Session's instructions in order, each naming its Session: a Session's `start` always follows the last Session's `stop`. Replays every instruction after `Last-Event-ID`, then stays open. The stream closes when the Instance is let go.",
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "description": "The seq of the last instruction this supervisor received. Absent means from the beginning.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stream is open. Each event carries an instruction and the Session it is for as its data, the instruction's kind as its event name, and its seq as its id. An event named `read` carries a `Read` instead, and no id: it is never stored, and a reconnect never replays it.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Instruction"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    },
    "/link/instances/{instance}/reports": {
      "post": {
        "operationId": "report",
        "summary": "Report something about an Instance, or the Session it carries, to the control plane.",
        "description": "Delivery is at-least-once: a supervisor that loses the answer to a report sends it again under the same seq, and the control plane takes it once. Seqs are counted within the Session a report names; one that skips a report the Session has yet to make is refused. A report about a Session the Instance no longer carries \u2014 it has ended, or its lease has passed \u2014 is answered 410, and the supervisor lets that Session go.",
        "parameters": [
          {
            "$ref": "#/components/parameters/instance"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The report was accepted. Connected reports return the Workspace checkout declaration, so a supervisor can inspect a held Instance even between Sessions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkout"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Refused"
          },
          "401": {
            "$ref": "#/components/responses/Refused"
          },
          "403": {
            "$ref": "#/components/responses/Refused"
          },
          "410": {
            "$ref": "#/components/responses/Refused"
          },
          "503": {
            "$ref": "#/components/responses/Refused"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "instanceCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "The credential issued for the Instance when its supervisor was started. Refused once the Instance is let go, and once another supervisor is started on it."
      }
    },
    "parameters": {
      "instance": {
        "name": "instance",
        "in": "path",
        "required": true,
        "description": "The Instance this supervisor runs on, as `<driver>/<name>`, percent-encoded as one path segment.",
        "schema": {
          "type": "string"
        }
      },
      "session": {
        "name": "session",
        "in": "query",
        "required": true,
        "description": "The Session the Instance is carrying, which alone is handed anything of a Session's.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Refused": {
        "description": "The link refused the request.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before asking again. Present on a 503 only when the database was busy, which asking again can clear.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Refusal"
            }
          }
        }
      }
    },
    "schemas": {
      "Credentials": {
        "description": "What a Harness is spawned with to reach a model: the Provider Credentials of the Session's Organization and the Subscription Profile its Workspace names.",
        "type": "object",
        "properties": {
          "variables": {
            "description": "The environment variable each credential is read from, and what it is read as. A profile's variable takes the place of a Provider Credential of the same name.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "files": {
            "description": "Each file's path beneath the agent's home, and its contents.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "variables",
          "files"
        ],
        "additionalProperties": false
      },
      "Refreshed": {
        "type": "object",
        "properties": {
          "files": {
            "description": "Each rewritten file's path beneath the agent's home, and what it now holds.",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      },
      "Instruction": {
        "description": "What the control plane asks of an Instance, for the Session it names.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Start"
          },
          {
            "$ref": "#/components/schemas/Prompt"
          },
          {
            "$ref": "#/components/schemas/Stop"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "start": "#/components/schemas/Start",
            "prompt": "#/components/schemas/Prompt",
            "stop": "#/components/schemas/Stop"
          }
        },
        "properties": {
          "session": {
            "description": "The Session this instruction is for.",
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "session"
        ]
      },
      "Start": {
        "description": "Take up the Session: check out, then open its one agent conversation and prompt its first turn. A checkout that fails is reported as the Session finished failed, and the Session never starts.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "start"
          },
          "checkout": {
            "$ref": "#/components/schemas/Checkout"
          },
          "prompt": {
            "description": "The agent's whole prompt, sent exactly as given: the Workspace's unfollowed Brief, or the message or messages that started this Session with earlier Transcript entries as labeled context ahead of them.",
            "type": "string"
          },
          "harness": {
            "$ref": "#/components/schemas/Harness"
          }
        },
        "required": [
          "kind",
          "checkout",
          "prompt",
          "harness"
        ]
      },
      "Prompt": {
        "description": "Prompt the next turn, in the conversation the Session's first turn opened. Sent only once the turn before it is answered.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "prompt"
          },
          "prompt": {
            "description": "The agent's whole prompt, sent exactly as given.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "prompt"
        ]
      },
      "Read": {
        "description": "A read of the Instance's checkouts, answered by POSTing to `answers/{request}`. Paths are `<repo>/<path>`, resolved through symlinks, and refused outside that repository's checkout.",
        "oneOf": [
          { "$ref": "#/components/schemas/ReadFiles" },
          { "$ref": "#/components/schemas/ReadFile" }
        ],
        "discriminator": {
          "propertyName": "read",
          "mapping": {
            "files": "#/components/schemas/ReadFiles",
            "file": "#/components/schemas/ReadFile"
          }
        },
        "properties": {
          "request": { "type": "string", "format": "uuid" }
        },
        "required": ["request"]
      },
      "ReadFiles": {
        "description": "One directory level, at most 5,000 entries, each marked tracked, untracked or ignored. No path lists the repositories.",
        "type": "object",
        "properties": {
          "read": { "const": "files" },
          "path": { "type": "string" }
        },
        "required": ["read"]
      },
      "ReadFile": {
        "description": "A file: UTF-8 text up to 1 MiB as a `text` answer, otherwise, or when `raw`, its bytes.",
        "type": "object",
        "properties": {
          "read": { "const": "file" },
          "path": { "type": "string" },
          "raw": { "type": "boolean" }
        },
        "required": ["read", "path", "raw"]
      },
      "Answer": {
        "oneOf": [
          { "$ref": "#/components/schemas/AnswerListing" },
          { "$ref": "#/components/schemas/AnswerText" },
          { "$ref": "#/components/schemas/AnswerRefused" },
          { "$ref": "#/components/schemas/AnswerMissing" }
        ],
        "discriminator": {
          "propertyName": "answer",
          "mapping": {
            "listing": "#/components/schemas/AnswerListing",
            "text": "#/components/schemas/AnswerText",
            "refused": "#/components/schemas/AnswerRefused",
            "missing": "#/components/schemas/AnswerMissing"
          }
        }
      },
      "AnswerListing": {
        "type": "object",
        "properties": {
          "answer": { "const": "listing" },
          "path": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "enum": ["file", "directory", "symlink", "other"] },
                "size": { "type": "integer", "minimum": 0 },
                "git": { "enum": ["tracked", "untracked", "ignored"] }
              },
              "required": ["name", "kind"]
            }
          },
          "total": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        },
        "required": ["answer", "path", "entries", "total", "truncated"]
      },
      "AnswerText": {
        "type": "object",
        "properties": {
          "answer": { "const": "text" },
          "path": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["answer", "path", "text"]
      },
      "AnswerRefused": {
        "description": "Outside the checkout, or not the kind of entry the read needs.",
        "type": "object",
        "properties": {
          "answer": { "const": "refused" },
          "message": { "type": "string" }
        },
        "required": ["answer", "message"]
      },
      "AnswerMissing": {
        "description": "No such repository or path.",
        "type": "object",
        "properties": {
          "answer": { "const": "missing" },
          "message": { "type": "string" }
        },
        "required": ["answer", "message"]
      },
      "Checkout": {
        "description": "What the agent works in: each repository cloned into the working directory, on the branch, which is cut from the base when the repository does not have it yet.",
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "base": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          }
        },
        "required": [
          "repositories",
          "base",
          "branch"
        ],
        "additionalProperties": false
      },
      "Harness": {
        "description": "What the supervisor spawns for this Session, which may be another Agent's than the last Session's on the Instance.",
        "type": "object",
        "properties": {
          "command": {
            "description": "The ACP agent command line.",
            "type": "string"
          },
          "auth": {
            "description": "The ACP authentication method to log the agent in with, for an agent that requires one.",
            "type": "string"
          },
          "model": {
            "description": "The model the Session named. Absent leaves the harness's default.",
            "type": "string"
          }
        },
        "required": [
          "command"
        ]
      },
      "Stop": {
        "description": "End the Session's agent conversation and let the Session go. The supervisor stays on the link.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "stop"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Report": {
        "description": "What a supervisor tells the control plane. `connected` and `heartbeat` are about the Instance; every other report names the Session it is about, and one that belongs to its ordered account of that Session carries a seq and is taken once.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/Connected"
          },
          {
            "$ref": "#/components/schemas/Heartbeat"
          },
          {
            "$ref": "#/components/schemas/Work"
          },
          {
            "$ref": "#/components/schemas/Stderr"
          },
          {
            "$ref": "#/components/schemas/Started"
          },
          {
            "$ref": "#/components/schemas/Model"
          },
          {
            "$ref": "#/components/schemas/Said"
          },
          {
            "$ref": "#/components/schemas/Used"
          },
          {
            "$ref": "#/components/schemas/Answered"
          },
          {
            "$ref": "#/components/schemas/CheckoutObserved"
          },
          {
            "$ref": "#/components/schemas/Finished"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "connected": "#/components/schemas/Connected",
            "heartbeat": "#/components/schemas/Heartbeat",
            "work": "#/components/schemas/Work",
            "stderr": "#/components/schemas/Stderr",
            "started": "#/components/schemas/Started",
            "model": "#/components/schemas/Model",
            "said": "#/components/schemas/Said",
            "used": "#/components/schemas/Used",
            "answered": "#/components/schemas/Answered",
            "checkout": "#/components/schemas/CheckoutObserved",
            "finished": "#/components/schemas/Finished"
          }
        },
        "properties": {
          "session": {
            "description": "The Session this report is about. Required on every report but `connected`, `heartbeat` and `stderr`.",
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Connected": {
        "description": "The supervisor is on the link, and this is what is running in the Instance.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "connected"
          },
          "version": {
            "type": "string",
            "description": "The supervisor's version."
          }
        },
        "required": [
          "kind",
          "version"
        ]
      },
      "Heartbeat": {
        "description": "The supervisor is still alive, and holds out the lease of the Session it carries for another turn of the clock. Sent for as long as the Instance lives; when it stops, a Session's lease expires and the Session ends failed.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        },
        "required": [
          "kind"
        ]
      },
      "Stderr": {
        "description": "Lines the Harness wrote to stderr, oldest first, sent as it writes them. They are the operator's diagnostics, never anything the agent said, and a line the link was not there to take in time is not sent again.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "stderr"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "lines"
        ]
      },
      "Started": {
        "description": "The Session has started.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "started"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq"
        ]
      },
      "Model": {
        "description": "Which model the Harness is on for this turn \u2014 the one the Session's Agent named, or the harness's own default when it named none. Absent for a harness that lets no client select one at all.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "model"
          },
          "model": {
            "type": "string"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq",
          "model"
        ]
      },
      "Said": {
        "description": "What the Harness said, coalesced into one message at the end of a turn. An Agent's reasoning and its tool calls are the Session's business and are never reported.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "said"
          },
          "message": {
            "type": "string"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq",
          "message"
        ]
      },
      "Used": {
        "description": "What the Harness has spent so far. Recorded on the Session, and never in a Transcript.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "used"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq",
          "usage"
        ]
      },
      "Answered": {
        "description": "The agent answered the turn, and its conversation waits for another prompt. The Session goes on.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "answered"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq"
        ]
      },
      "CheckoutObserved": {
        "description": "What git says of each of the Project's repositories once the agent has stopped working in it, reported before the Session finishes. The control plane judges from it whether the Instance holds work that exists nowhere else; a Session that finishes without one leaves its Instance held.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "checkout"
          },
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observed"
            }
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq",
          "repositories"
        ]
      },
      "Observed": {
        "description": "One repository's checkout: counted from git when it could be read, and why not when it could not.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ObservedRead"
          },
          {
            "$ref": "#/components/schemas/ObservedUnreadable"
          }
        ],
        "discriminator": {
          "propertyName": "git",
          "mapping": {
            "read": "#/components/schemas/ObservedRead",
            "unreadable": "#/components/schemas/ObservedUnreadable"
          }
        }
      },
      "ObservedRead": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string"
          },
          "git": {
            "const": "read"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "The branch checked out, or null on a detached HEAD."
          },
          "untracked": {
            "type": "integer",
            "minimum": 0,
            "description": "Files git neither tracks nor ignores."
          },
          "uncommitted": {
            "type": "integer",
            "minimum": 0,
            "description": "Tracked paths changed and not committed, staged or not."
          },
          "stashes": {
            "type": "integer",
            "minimum": 0
          },
          "unpushed": {
            "type": "integer",
            "minimum": 0,
            "description": "Commits on any local branch or HEAD that no remote-tracking branch reaches."
          }
        },
        "required": [
          "repository",
          "git",
          "branch",
          "untracked",
          "uncommitted",
          "stashes",
          "unpushed"
        ]
      },
      "ObservedUnreadable": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string"
          },
          "git": {
            "const": "unreadable"
          },
          "because": {
            "type": "string"
          }
        },
        "required": [
          "repository",
          "git",
          "because"
        ]
      },
      "Finished": {
        "description": "The Session is over, and this is how it went: its conversation failed, or it never started. The supervisor lets the Session go after saying so, and stays on the link.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "finished"
          },
          "exit": {
            "$ref": "#/components/schemas/Exit"
          },
          "seq": {
            "$ref": "#/components/schemas/Seq"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "kind",
          "session",
          "seq",
          "exit"
        ]
      },
      "Seq": {
        "description": "Where a report sits in the sequence the supervisor numbers for its Session. The control plane takes each number once, so a report replayed after an answer that never arrived changes the record once.",
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "Exit": {
        "description": "How a Session ended.",
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "because": {
            "type": "string",
            "description": "Why it failed. Absent when it succeeded."
          }
        },
        "required": [
          "status"
        ]
      },
      "Usage": {
        "description": "Cumulative rather than per turn: the last report of it is the one that stands.",
        "type": "object",
        "properties": {
          "context_used": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens currently in context."
          },
          "context_size": {
            "type": "integer",
            "minimum": 0,
            "description": "The context window, in tokens."
          },
          "cost": {
            "type": "object",
            "description": "What it has cost so far. Absent when the harness does not say.",
            "properties": {
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "description": "An ISO 4217 currency code."
              }
            },
            "required": [
              "amount",
              "currency"
            ]
          }
        },
        "required": [
          "context_used",
          "context_size"
        ]
      },
      "Refusal": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "Page": {
        "description": "One bounded window of a Transcript, and where the next read resumes.",
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recorded"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the next read resumes. Null only for a read that started at the beginning and found nothing."
          },
          "more": {
            "type": "boolean",
            "description": "Whether entries were waiting beyond this window when it was read."
          }
        },
        "required": [
          "entries",
          "cursor",
          "more"
        ]
      },
      "Recorded": {
        "description": "One Transcript entry, and where it sits in the order.",
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "appended_at": {
            "type": "string",
            "format": "date-time"
          },
          "entry": {
            "$ref": "#/components/schemas/Entry"
          }
        },
        "required": [
          "seq",
          "appended_at",
          "entry"
        ]
      },
      "Entry": {
        "description": "What changed the Workspace's shared state. Never what happened inside a Session.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ParticipantJoined"
          },
          {
            "$ref": "#/components/schemas/Brief"
          },
          {
            "$ref": "#/components/schemas/SessionStarted"
          },
          {
            "$ref": "#/components/schemas/Message"
          },
          {
            "$ref": "#/components/schemas/Messages"
          },
          {
            "$ref": "#/components/schemas/SessionEnded"
          },
          {
            "$ref": "#/components/schemas/InstanceReleased"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "participant_joined": "#/components/schemas/ParticipantJoined",
            "brief": "#/components/schemas/Brief",
            "session_started": "#/components/schemas/SessionStarted",
            "said": "#/components/schemas/Message",
            "messages": "#/components/schemas/Messages",
            "session_ended": "#/components/schemas/SessionEnded",
            "instance_released": "#/components/schemas/InstanceReleased"
          }
        }
      },
      "ParticipantJoined": {
        "description": "A Participant joined the Workspace.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "participant_joined"
          },
          "participant": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "participant"
        ]
      },
      "Brief": {
        "description": "The instruction a Workspace started with, rendered by the Trigger that fired.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "brief"
          },
          "trigger": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "trigger",
          "brief"
        ]
      },
      "SessionStarted": {
        "description": "A Session started on behalf of the Workspace.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "session_started"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          },
          "agent": {
            "description": "The Agent the Session runs.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "session",
          "agent"
        ]
      },
      "Message": {
        "description": "What a Participant said.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "said"
          },
          "participant": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "participant",
          "message"
        ]
      },
      "Messages": {
        "description": "Messages that arrived while a Session was active, drained as one Transcript entry.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "messages"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SpokenMessage"
            }
          }
        },
        "required": [
          "kind",
          "messages"
        ]
      },
      "SpokenMessage": {
        "description": "One Participant's message within a drained group.",
        "type": "object",
        "properties": {
          "participant": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "participant",
          "message"
        ]
      },
      "SessionEnded": {
        "description": "A Session ended, and how it went.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "session_ended"
          },
          "session": {
            "type": "string",
            "format": "uuid"
          },
          "exit": {
            "$ref": "#/components/schemas/Exit"
          }
        },
        "required": [
          "kind",
          "session",
          "exit"
        ]
      },
      "InstanceReleased": {
        "description": "A person released the Workspace's Instance, destroying it and whatever it held that was never pushed.",
        "type": "object",
        "properties": {
          "kind": {
            "const": "instance_released"
          },
          "participant": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "unpublished": {
            "type": [
              "string",
              "null"
            ],
            "description": "What it held that existed nowhere else, as judged when it was released; null when it held nothing."
          }
        },
        "required": [
          "kind",
          "participant",
          "instance",
          "unpublished"
        ]
      },
      "WorkChanges": {
        "type": "object",
        "properties": {
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "files",
          "added",
          "removed"
        ]
      },
      "WorkCommits": {
        "type": "object",
        "properties": {
          "commits": {
            "type": "integer",
            "minimum": 0
          },
          "added": {
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "commits",
          "added",
          "removed"
        ]
      },
      "WorkRepositoryRead": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string"
          },
          "git": {
            "const": "read"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "changed": {
            "$ref": "#/components/schemas/WorkChanges"
          },
          "staged": {
            "$ref": "#/components/schemas/WorkChanges"
          },
          "committed": {
            "$ref": "#/components/schemas/WorkCommits"
          },
          "pushed": {
            "type": [
              "string",
              "null"
            ]
          },
          "untracked": {
            "type": "integer",
            "minimum": 0
          },
          "stashed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "repository",
          "git",
          "branch",
          "changed",
          "staged",
          "committed",
          "pushed",
          "untracked",
          "stashed"
        ]
      },
      "WorkRepositoryUnreadable": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string"
          },
          "git": {
            "const": "unreadable"
          },
          "because": {
            "type": "string"
          }
        },
        "required": [
          "repository",
          "git",
          "because"
        ]
      },
      "WorkRepository": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/WorkRepositoryRead"
          },
          {
            "$ref": "#/components/schemas/WorkRepositoryUnreadable"
          }
        ],
        "discriminator": {
          "propertyName": "git",
          "mapping": {
            "read": "#/components/schemas/WorkRepositoryRead",
            "unreadable": "#/components/schemas/WorkRepositoryUnreadable"
          }
        }
      },
      "Work": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "work"
          },
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkRepository"
            }
          }
        },
        "required": [
          "kind",
          "repositories"
        ],
        "description": "Unnumbered and non-durable. Sent on connect, when a two-second check during a turn finds a change, and at turn close. Does not alter the durable checkout observation."
      }
    }
  }
}
