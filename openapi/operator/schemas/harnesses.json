{
  "HarnessCatalogueEntry": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "command": {
        "type": "string",
        "description": "The default ACP command; explicit harness-command configuration remains authoritative."
      },
      "sign_in_methods": {
        "type": "array",
        "items": {
          "$ref": "#/SignInMethod"
        }
      },
      "availability": {
        "description": "Whether the configured image declares this harness, read from the image at this request. Null only in the catalogue's own data, never in a response.",
        "anyOf": [
          {
            "$ref": "#/HarnessAvailability"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "name",
      "command",
      "sign_in_methods",
      "availability"
    ],
    "additionalProperties": false
  },
  "HarnessAvailability": {
    "type": "object",
    "description": "`available` and `not_carried` come from inspecting the configured image's `dev.kestrel.harnesses` label (ADR-0048). `unavailable` means the inspection failed, so nothing is claimed about the harness, and carries why. `unchecked` means the compute driver runs no image.",
    "properties": {
      "state": {
        "type": "string",
        "enum": [
          "available",
          "not_carried",
          "unchecked",
          "unavailable"
        ]
      },
      "image": {
        "type": [
          "string",
          "null"
        ],
        "description": "The configured image reference."
      },
      "identity": {
        "type": [
          "string",
          "null"
        ],
        "description": "The immutable local image ID the reference resolved to when it was inspected."
      },
      "diagnostic": {
        "anyOf": [
          {
            "$ref": "refusals.json#/Diagnostic"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "state",
      "image",
      "identity",
      "diagnostic"
    ],
    "additionalProperties": false
  },
  "SignInMethod": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "subscription",
          "key"
        ]
      },
      "ownership": {
        "type": "string",
        "enum": [
          "operator",
          "organization"
        ]
      },
      "fills": {
        "$ref": "sign-ins.json#/SignInFill"
      },
      "input": {
        "type": "string",
        "enum": [
          "token",
          "file"
        ]
      },
      "relay": {
        "type": "string",
        "enum": [
          "claude-setup-token",
          "codex-device-auth"
        ]
      },
      "console_url": {
        "type": "string",
        "format": "uri"
      },
      "test_providers": {
        "type": "array",
        "description": "The providers a model test of this method may name as the `provider/` prefix of its model. Present where a test requires a model; absent where the harness's own default is tested when none is named.",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "id",
      "name",
      "kind",
      "ownership",
      "fills",
      "input"
    ],
    "additionalProperties": false
  }
}
