{
  "ProviderCredentialSecret": {
    "type": "object",
    "properties": {
      "secret": {
        "type": "string",
        "minLength": 1,
        "writeOnly": true
      }
    },
    "required": [
      "secret"
    ]
  },
  "ProviderCredential": {
    "description": "A credential as everything but the Session that carries it sees it.",
    "type": "object",
    "properties": {
      "variable": {
        "type": "string"
      },
      "set_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "variable",
      "set_at"
    ]
  },
  "SubscriptionProfileDeclaration": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "owner": {
        "type": "string",
        "minLength": 1,
        "description": "The person it belongs to, which never changes."
      }
    },
    "required": [
      "name"
    ]
  },
  "SubscriptionProfile": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "owner_operator": {
        "type": ["string", "null"],
        "format": "uuid"
      }
    },
    "required": [
      "id",
      "name",
      "owner",
      "owner_operator"
    ]
  },
  "SubscriptionProfileLogin": {
    "description": "A login as everything but the Session that carries it sees it.",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "variable",
          "file"
        ]
      },
      "name": {
        "type": "string",
        "description": "The variable, or the path beneath the agent's home."
      },
      "set_at": {
        "type": "string",
        "format": "date-time",
        "description": "When it was last held, whether by a person or by a Session handing back a refreshed login."
      }
    },
    "required": [
      "kind",
      "name",
      "set_at"
    ]
  },
  "SubscriptionProfileListed": {
    "allOf": [
      {
        "$ref": "#/SubscriptionProfile"
      },
      {
        "type": "object",
        "properties": {
          "holds": {
            "type": "array",
            "items": {
              "$ref": "#/SubscriptionProfileLogin"
            }
          }
        },
        "required": [
          "holds"
        ]
      }
    ]
  }
}
