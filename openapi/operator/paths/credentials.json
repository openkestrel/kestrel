{
  "credentials": {
    "get": {
      "operationId": "listProviderCredentials",
      "summary": "List the Provider Credentials an Organization holds.",
      "description": "Each by the variable it is read from and when it was set, and never by value.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Every credential held, ordered by variable.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/credentials.json#/ProviderCredential"
                }
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "credentials-variable": {
    "put": {
      "operationId": "holdProviderCredential",
      "summary": "Hold a Provider Credential.",
      "description": "Replaces whatever the Organization held under this variable. The secret is encrypted at rest and never answered back.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variable",
          "in": "path",
          "required": true,
          "description": "The environment variable a Harness reads the credential from.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/credentials.json#/ProviderCredentialSecret"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The credential is held.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credentials.json#/ProviderCredential"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "delete": {
      "operationId": "forgetProviderCredential",
      "summary": "Forget a Provider Credential.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variable",
          "in": "path",
          "required": true,
          "description": "The environment variable a Harness reads the credential from.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "The credential is forgotten."
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "profiles": {
    "get": {
      "operationId": "listSubscriptionProfiles",
      "summary": "List the Subscription Profiles declared in an Organization.",
      "description": "Each with its owner and what it holds, by kind and name and when it was set, and never by value.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Every profile declared, ordered by name.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/credentials.json#/SubscriptionProfileListed"
                }
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "post": {
      "operationId": "declareSubscriptionProfile",
      "summary": "Declare a Subscription Profile.",
      "description": "A person's login to a subscribed Harness. It reaches only the Sessions of Workspaces that name it. A profile by this name that already exists is answered as it is; one that belongs to someone else is refused with 409, because a profile never changes hands.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/credentials.json#/SubscriptionProfileDeclaration"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "A profile by this name already existed, and belongs to this owner.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credentials.json#/SubscriptionProfile"
              }
            }
          }
        },
        "201": {
          "description": "No profile by this name existed, and one was made.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credentials.json#/SubscriptionProfile"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "profiles-profile-variables-variable": {
    "put": {
      "operationId": "holdSubscriptionProfileVariable",
      "summary": "Hold a variable in a Subscription Profile.",
      "description": "Replaces whatever the profile held as this variable. It is put into the Harness's environment as the Session is spawned. It is encrypted at rest and never answered back.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "profile",
          "in": "path",
          "required": true,
          "description": "The name of the Subscription Profile.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variable",
          "in": "path",
          "required": true,
          "description": "The environment variable the Harness is spawned with.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/credentials.json#/ProviderCredentialSecret"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The login is held.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credentials.json#/SubscriptionProfileLogin"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "delete": {
      "operationId": "forgetSubscriptionProfileVariable",
      "summary": "Forget a variable a Subscription Profile holds.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "profile",
          "in": "path",
          "required": true,
          "description": "The name of the Subscription Profile.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "variable",
          "in": "path",
          "required": true,
          "description": "The environment variable the Harness is spawned with.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "The login is forgotten."
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "profiles-profile-files-path": {
    "put": {
      "operationId": "holdSubscriptionProfileFile",
      "summary": "Hold a file in a Subscription Profile.",
      "description": "Replaces whatever the profile held as this file. It is written beneath the agent's home as the Session is spawned, read back as the Session ends, and held again if the harness rewrote it, so a refreshed login persists; the secret is the file's contents, byte for byte. It is encrypted at rest and never answered back.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "profile",
          "in": "path",
          "required": true,
          "description": "The name of the Subscription Profile.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "path",
          "in": "path",
          "required": true,
          "description": "Where the file sits beneath the agent's home, as one segment with its slashes percent-encoded.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/credentials.json#/ProviderCredentialSecret"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The login is held.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credentials.json#/SubscriptionProfileLogin"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "delete": {
      "operationId": "forgetSubscriptionProfileFile",
      "summary": "Forget a file a Subscription Profile holds.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "profile",
          "in": "path",
          "required": true,
          "description": "The name of the Subscription Profile.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "path",
          "in": "path",
          "required": true,
          "description": "Where the file sits beneath the agent's home, as one segment with its slashes percent-encoded.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "The login is forgotten."
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  }
}
