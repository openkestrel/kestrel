{
  "integrations": {
    "get": {
      "operationId": "listIntegrations",
      "summary": "List every Integration in an Organization.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Every record, ordered by name.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/integrations.json#/Integration"
                }
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "post": {
      "operationId": "registerIntegration",
      "summary": "Register an Integration.",
      "description": "The credentials a registration carries are held by the control plane and never answered back. A name the Organization already gives an Integration is refused with 409.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/integrations.json#/IntegrationRegistration"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "The Integration is registered.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration": {
    "get": {
      "operationId": "showIntegration",
      "summary": "Show an Integration.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The named Integration.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    },
    "patch": {
      "operationId": "changeIntegration",
      "summary": "Change an Integration's name, directions or poll interval.",
      "description": "Its Organization, kind, API origin, repository, App and installation identify the connection and cannot change; naming one is refused with 422. An invalid direction or interval is refused before anything is saved. Every change bumps the revision, and a change naming an older `revision` is refused with 409.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/integrations.json#/IntegrationChange"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The changed Integration.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-disable": {
    "post": {
      "operationId": "disableIntegration",
      "summary": "Disable an Integration.",
      "description": "Pauses its polling, webhook ingestion, outbound posts, dispatch and held Firings, keeping its credentials, cursor and pending posts. Running Sessions continue, and a request already sent to the external system is not recalled. Disabling a disabled Integration changes nothing.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The disabled Integration.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-enable": {
    "post": {
      "operationId": "enableIntegration",
      "summary": "Enable a disabled Integration.",
      "description": "Resumes what disabling paused; its poll reads on from where it stopped, within the external system's retention, and a gap it cannot read is reported on the Integration. Enabling an enabled Integration changes nothing.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The enabled Integration.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-retire": {
    "post": {
      "operationId": "retireIntegration",
      "summary": "Retire an Integration, permanently.",
      "description": "Erases the credentials kestrel holds for it and every token minted from them, cancels its pending posts with a reason, and cancels the Firings held on it in the same step. The Integration and every Project, Trigger, Event and Workspace that refers to it stay readable; it is never used, changed or enabled again, and no other Integration takes its place. Nothing is done on the external system: the GitHub App, its installation and its keys are untouched, and a request already sent or a credential already issued is not recalled. Retiring a retired Integration changes nothing.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/integrations.json#/IntegrationRetirement"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The retired Integration.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-private-key": {
    "put": {
      "operationId": "replaceIntegrationPrivateKey",
      "summary": "Replace a GitHub Integration's App private key.",
      "description": "The replacement is checked against GitHub first: it must sign as the same App, mint for the same installation and reach the same repository. Only then does it replace the stored key, in one write that bumps the revision, so an installation token minted with the previous key is never handed out afterwards. A replacement that is not accepted, an App that no longer reaches its installation or repository, a rate limit or an outage saves nothing and leaves the previous key in use. Maintenance that lands while GitHub is being asked refuses the replacement with 409. The key is never returned.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/integrations.json#/IntegrationPrivateKeyReplacement"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The Integration, at its new revision.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/integrations.json#/Integration"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "403": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-repositories": {
    "get": {
      "operationId": "listIntegrationRepositories",
      "summary": "List the repositories a GitHub Integration's App installation reaches.",
      "description": "Read from GitHub at each call, with each repository's default branch as GitHub names it. An installation that reaches none answers an empty page; a read GitHub refuses, limits or does not answer is a refusal, never an empty list or a guessed branch. The Integration must be an enabled GitHub one.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "description": "Counted from 1, the default.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        },
        {
          "name": "per_page",
          "in": "query",
          "required": false,
          "description": "30 by default, 100 at most.",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      ],
      "responses": {
        "200": {
          "description": "One page, in GitHub's order.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/organizations.json#/IntegrationRepositories"
              }
            }
          }
        },
        "400": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "403": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "409": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  },
  "integrations-integration-event-refusal": {
    "delete": {
      "operationId": "acknowledgeEventRefusal",
      "summary": "Acknowledge the latest Event an Integration refused.",
      "description": "Clears the refusal an Integration keeps visible. Acknowledging when there is none changes nothing.",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "description": "The name of the Organization the records belong to.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "integration",
          "in": "path",
          "required": true,
          "description": "The name of the Integration.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "No refusal is visible on the Integration."
        },
        "404": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "$ref": "../../operator.json#/components/responses/Refused"
        }
      }
    }
  }
}
