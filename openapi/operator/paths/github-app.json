{
  "github-app": {
    "post": {
      "operationId": "startGithubApp",
      "summary": "Start GitHub App creation before choosing a repository",
      "parameters": [
        {
          "name": "organization",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/github-app.json#/GithubAppStart"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Open this URL in a browser within one hour",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/github-app.json#/GithubAppStarted"
              }
            }
          }
        },
        "403": {
          "description": "Setup refused",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/refusals.json#/DiagnosedRefusal"
              }
            }
          }
        },
        "409": {
          "description": "Setup refused",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/refusals.json#/DiagnosedRefusal"
              }
            }
          }
        },
        "422": {
          "$ref": "../../operator.json#/components/responses/Refused"
        },
        "503": {
          "description": "Setup refused",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/refusals.json#/DiagnosedRefusal"
              }
            }
          }
        }
      }
    }
  },
  "github-app-setup": {
    "get": {
      "operationId": "githubAppSetup",
      "summary": "Render the GitHub manifest form",
      "parameters": [
        {
          "name": "state",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "installation_id",
          "in": "query",
          "required": false,
          "schema": { "type": "integer" },
          "description": "Server setup continuation; verified through the App before repository selection"
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Browser setup page; no credentials",
          "content": {
            "text/html": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "403": {
          "description": "Setup refused",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/refusals.json#/DiagnosedRefusal"
              }
            }
