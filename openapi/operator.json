{
  "openapi": "3.1.0",
  "info": {
    "title": "kestrel operator",
    "version": "0.1.0",
    "summary": "The boundary a Client reaches a control plane over.",
    "description": "Server-sent events down, JSON up, plain HTTP. It authenticates nobody, so the control plane serves it on a listener of its own, apart from the link, and binds that listener to loopback unless told otherwise. A remote control plane is reached through a tunnel. Every operation refuses with 403, and does nothing, a request whose Host is not loopback, or whose Origin, when it sends one, is not exactly http:// followed by that Host.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "{controlPlane}",
      "variables": {
        "controlPlane": {
          "default": "http://127.0.0.1:7718"
        }
      }
    }
  ],
  "security": [],
