  "components": {
    "responses": {
      "Refused": {
        "description": "The control plane refused the request, with a typed Diagnostic (ADR-0052) where its producer is typed and a plain Refusal where it is not yet; only `kind` tells them apart. 400 is a malformed request; 403 is a forbidden action, such as changing a Held Message its author did not write; 404 is a missing or ambiguous reference; 409 is a state conflict, or a declined operation not yet typed; 410 is an expired resource; 422 is an invalid field value; 503 is a control plane that could not answer; 504 is an Instance that did not answer a read within 10 s. 400, 503 and 504 are always typed.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before asking again. Present on a 503 only when the database was busy, which asking again can clear; the Diagnostic's `retry_after_seconds` carries the same value.",
            "schema": { "type": "integer" }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "operator/schemas/refusals.json#/DiagnosedRefusal"
            }
          }
        }
      }
    }
  }
