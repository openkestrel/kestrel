{
	admin off
	auto_https off
	persist_config off
}

http://{$KESTREL_CLIENT_LISTEN::8080} {
	root * {$KESTREL_CLIENT_ROOT:/srv}

	# Caddy forwards the browser's Host unchanged, which the operator listener's Host check
	# requires (ADR-0036); a proxy that rewrites it to the upstream's name is refused.
	@operator path /operator /operator/*
	handle @operator {
		reverse_proxy {$KESTREL_CONTROL_PLANE:http://127.0.0.1:7718}
	}

	@built {
		path /assets/*
		file
	}
	handle @built {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /assets/* {
		error 404
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
