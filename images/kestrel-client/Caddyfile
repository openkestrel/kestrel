{
	admin off
	persist_config off
	# The operator trusts Caddy's local CA once, by hand (USAGE.md); Caddy never edits a trust store.
	skip_install_trust
	auto_https disable_redirects
	# A browser sends no SNI to an IP, and in a container the local address is not 127.0.0.1.
	default_sni 127.0.0.1
}

# HTTPS so the browser speaks HTTP/2: over HTTP/1.1 its six connections per origin, shared by every
# tab, run out once a few event streams are open (ADR-0035).
https://localhost:{$KESTREL_CLIENT_LISTEN_PORT:8080}, https://127.0.0.1:{$KESTREL_CLIENT_LISTEN_PORT:8080} {
	tls internal
	root * {$KESTREL_CLIENT_ROOT:/srv}

	# Caddy forwards the browser's Host unchanged, which the operator listener's Host check
	# requires (ADR-0036); a proxy that rewrites it to the upstream's name is refused.
	@operator path /operator /operator/*
	handle @operator {
		reverse_proxy {$KESTREL_CONTROL_PLANE:http://127.0.0.1:7718}
	}

	@built {
		path /assets/*
		file
	}
	handle @built {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /assets/* {
		error 404
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
