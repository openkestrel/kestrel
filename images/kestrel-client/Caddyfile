{
	admin off
	persist_config off
}

# Plain HTTP on loopback: a tab holds one event stream, so HTTP/1.1's six connections per origin
# carry about five tabs, and a first run trusts no certificate (ADR-0045).
http://:{$KESTREL_CLIENT_LISTEN_PORT:8080} {
	root * {$KESTREL_CLIENT_ROOT:/srv}

	# Caddy forwards the browser's Host unchanged, which the operator listener's Host check
	# requires (ADR-0036); a proxy that rewrites it to the upstream's name is refused.
	@operator path /operator /operator/*
	handle @operator {
		reverse_proxy {$KESTREL_CONTROL_PLANE:http://127.0.0.1:7718}
	}

	@built {
		path /assets/*
		file
	}
	handle @built {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /assets/* {
		error 404
	}

	handle {
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	# Only this proxy can tell a control plane that never answered from one that refused.
	handle_errors 502 503 504 {
		header @operator Content-Type application/json
		respond @operator `\{"kind":"connection_failed","message":"kestrel isn't running","field":null,"context":\{"url":"http://{http.request.hostport}","operation":"{http.request.method} {http.request.uri.path}"\},"next_steps":[\{"action":"check_connection","service":"control_plane","compose":{$KESTREL_COMPOSE:false}\}]\}`
	}
}
